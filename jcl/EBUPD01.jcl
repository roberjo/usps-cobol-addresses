//EBUPD01  JOB (AMS0001),'AMS EDIT BOOK UPD',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* EBUPD01 - AMS EDIT BOOK UPDATE.  REFERENCE JCL, NOT EXECUTED
//* LOCALLY: JOBS/EBUPD01.SH RUNS THE SAME STEPS WITH DD_<NAME> VARS.
//*
//* RESTART: IF STEP030 ABENDS, RESUBMIT WITH RESTART=STEP030 ON THE
//*          JOB CARD AND RESTART=Y IN THE CONTROL CARDS. EBUPDT READS
//*          ITS CHECKPOINT ROW AND SKIPS WORK ALREADY COMMITTED.
//*--------------------------------------------------------------------
//JOBLIB   DD DSN=AMS.EB.LOADLIB,DISP=SHR
//         DD DSN=DSNP.SDSNLOAD,DISP=SHR
//*
//*------------------------------------------ DELETE LAST RUN'S FILES
//STEP000  EXEC PGM=IEFBR14
//DEL01    DD DSN=AMS.EB.WORK.EBVALOUT,DISP=(MOD,DELETE,DELETE),
//            SPACE=(TRK,0)
//DEL02    DD DSN=AMS.EB.WORK.EBSRTOUT,DISP=(MOD,DELETE,DELETE),
//            SPACE=(TRK,0)
//DEL03    DD DSN=AMS.EB.EBREJ,DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//DEL04    DD DSN=AMS.EB.EBUREJ,DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//DEL05    DD DSN=AMS.EB.EBAUDIT,DISP=(MOD,DELETE,DELETE),
//            SPACE=(TRK,0)
//*
//*------------------------------------------ VALIDATE TRANSACTIONS
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DSNP)
  RUN PROGRAM(EBVALID) PLAN(EBUPDPLN)
  END
/*
//SYSIN    DD DSN=AMS.EB.CTLCARDS(EBUPD01),DISP=SHR
//EBTRANS  DD DSN=AMS.EB.EBTRANS.DAILY(0),DISP=SHR
//EBVALOUT DD DSN=AMS.EB.WORK.EBVALOUT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//EBREJ    DD DSN=AMS.EB.EBREJ,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=82,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//*
//*------------------------------------------ SORT INTO UPDATE ORDER
//* ZIP5 A, ROUTE A, DELIVERY SEQ (PACKED) D, ACTION D.  EQUALS KEEPS
//* INPUT ORDER FOR TIES.  LOCALLY THE COBOL PROGRAM EBSORT DOES THIS
//* WITH THE SORT VERB AND THE SAME KEYS.
//STEP020  EXEC PGM=SORT,COND=(8,LE)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=AMS.EB.WORK.EBVALOUT,DISP=SHR
//SORTOUT  DD DSN=AMS.EB.WORK.EBSRTOUT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(2,5,CH,A,7,4,CH,A,11,4,PD,D,1,1,CH,D),EQUALS
/*
//*
//*------------------------------------------ APPLY TO AMS (DB2)
//* DISP=MOD ON THE OUTPUTS LETS A RESTART EXTEND WHAT WAS WRITTEN
//* BEFORE THE LAST COMMIT.
//STEP030  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(8,LE)
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DSNP)
  RUN PROGRAM(EBUPDT) PLAN(EBUPDPLN)
  END
/*
//SYSIN    DD DSN=AMS.EB.CTLCARDS(EBUPD01),DISP=SHR
//EBSRTOUT DD DSN=AMS.EB.WORK.EBSRTOUT,DISP=SHR
//EBAUDIT  DD DSN=AMS.EB.EBAUDIT,DISP=(MOD,CATLG,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//EBUREJ   DD DSN=AMS.EB.EBUREJ,DISP=(MOD,CATLG,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=82,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//*
//*------------------------------------------ REPORT + EDIT BOOKS
//* RUNS EVEN AFTER AN RC 8 FROM STEP010, SO REJECTS ARE STILL LISTED.
//STEP040  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(12,LE)
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DSNP)
  RUN PROGRAM(EBRPT) PLAN(EBUPDPLN)
  END
/*
//SYSIN    DD DSN=AMS.EB.CTLCARDS(EBUPD01),DISP=SHR
//EBREJ    DD DSN=AMS.EB.EBREJ,DISP=SHR
//EBUREJ   DD DSN=AMS.EB.EBUREJ,DISP=SHR
//EBAUDIT  DD DSN=AMS.EB.EBAUDIT,DISP=SHR
//EBRPT    DD SYSOUT=A,DCB=(RECFM=FBA,LRECL=133)
//EBBOOK   DD DSN=AMS.EB.EBBOOK(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
